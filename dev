#!/bin/bash
set -e
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd -P)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" = /* ]] || SOURCE="$DIRECTORY/$SOURCE"
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd -P)"
exec /bin/bash "$SCRIPT_DIR/runtime.sh" --dev "$@"
