{
  // Copy this file to ../dev_config.json and customize it. The private file
  // overrides these defaults, while this annotated sample is never rewritten.
  // Run `dev repo add <local-repo-path>` to add tracked repos; see
  // `dev repo add -h` for the available repository-entry options.
  // Exact version installed locally by dev init; no system Python is used.
  "pythonVersion": "3.12.10",
  // Windows only: "bash" adds Git Bash to Windows Terminal and makes it the default.
  // Use "system" to preserve the current Windows Terminal default.
  "defaultShell": "system",
  // dev init prompts with this default. Use "none" to skip AI; "claude" is not implemented yet.
  // `ai <tier>` runs that tier's model; "auto" is built in. Add tiers under
  // "models" (e.g. {"high": "<model-id>"}) and pick one with "defaultModel".
  // "continueModel" optionally picks a different tier for `ai -c`.
  // Each ~/dev_ai/<name> folder is an AI profile (skills/, .github/instructions/,
  // plugins.json). `ai --add-env <name> --add-flag -x` registers --<name> and -x
  // as launch flags and creates the folder.
  // Optional "profiles": {"<name>": {"flags", "command", "addWorkspace",
  // "defaultModel", "env"}} changes how a profile launches (see README).
  "ai": {
    "provider": "ghcopilot",
    "skills": true
  },
  "pr": {
    // Case-insensitive name patterns omitted by `dev pr policy`.
    // Use exact names, or explicit * and ? wildcards. Empty means no exclusions.
    "policyExclude": []
  },
  "repos": [
    {
      "path": "dev_cli",
      // A workspace link to the local tool checkout. `bootstrap` updates it
      // before other repositories, then the normal sync loop skips it.
      "pathLinksTo": "$HOME/dev_cli",
      "bootstrap": true
    }
  ],
  "workspaceRoots": {
    // Add a key for each machine, then set DEVCONFIG to that key.
    "example-machine": "$HOME"
  },
  "identity": {
    // Blank uses USERNAME, then USER, then the system login. Also supports
    // `branchPrefix` (default "user/<resolved-username>/") and
    // `creatorEmail` (default Git's global user.email).
    "username": ""
  },
  // Named shell setups applied with `dev set <name>`; `dev set` lists them.
  // Each may set "description", "path" (prepended to the base PATH),
  // "env" (null unsets a variable), and "cwd". $DEV is the workspace root.
  // Example: "tools": {"path": ["$DEV/tools/bin"], "cwd": "$DEV/tools"}
  "environments": {}
}
